      "id_question": "dlt_toan_12_bai_1_2_ketnoitrithuc-q17",
      "order": 17,
      "question": "Cho hàm số $y = f(x)$ có đạo hàm trên khoảng $(a; b)$.",
      "type_question": "true_false",
      "path_images": null,
      "answers": [
        {
          "id_answer": "dlt_toan_12_bai_1_2_ketnoitrithuc-q17-a",
          "answer": "Nếu $f'(x) > 0, \\forall x \\in (a; b)$ thì hàm số $f(x)$ đồng biến trên $(a; b)$."
        },
        {
          "id_answer": "dlt_toan_12_bai_1_2_ketnoitrithuc-q17-b",
          "answer": "Nếu hàm số $f(x)$ nghịch biến trên $(a; b)$ thì $f'(x) < 0, \\forall x \\in (a; b)$."
        },
        {
          "id_answer": "dlt_toan_12_bai_1_2_ketnoitrithuc-q17-c",
          "answer": "Điểm cực đại của hàm số luôn là điểm mà tại đó đạo hàm $f'(x)$ bằng $0$."
        },
        {
          "id_answer": "dlt_toan_12_bai_1_2_ketnoitrithuc-q17-d",
          "answer": "Nếu đạo hàm $f'(x)$ đổi dấu từ âm sang dương khi đi qua điểm $x_0 \\in (a;b)$ thì $x_0$ là điểm cực tiểu của hàm số."
        }
      ],
